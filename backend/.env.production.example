# Production Environment Variables Template
# Copy this file to .env and fill in the values

# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_v5Ea9ArkOZXK@ep-calm-firefly-a1mk2ln6-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ============================================
# SECURITY
# ============================================
# Secret key for session encryption (generate with: openssl rand -hex 32)
SECRET_KEY=PLEASE_CHANGE_THIS_TO_A_RANDOM_SECRET_KEY

# ============================================
# GOOGLE OAUTH
# ============================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Update this with your EC2 domain or IP
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback

# ============================================
# GITHUB OAUTH
# ============================================
# Get credentials from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# Update this with your EC2 domain or IP
GITHUB_REDIRECT_URI=https://your-domain.com/auth/github/callback

# ============================================
# FRONTEND & BACKEND URLs
# ============================================
# Frontend origin for CORS (your frontend URL)
FRONTEND_ORIGIN=https://your-frontend-domain.com
# OR for development: http://localhost:5173

# Backend URL (your EC2 domain or IP)
BACKEND_URL=https://your-domain.com

# ============================================
# ML MODEL
# ============================================
# Hugging Face token for downloading models (optional, for private models)
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=your-huggingface-token

# Hugging Face Space URL (if using external prediction service)
HF_SPACE_URL=https://gnaig04-phobertsum-app.hf.space/run/predict

# External prediction URL (if using separate ML service)
URL_PREDICT=https://your-ml-service-url.com/predict

# ============================================
# NOTES
# ============================================
# 1. NEVER commit this file to Git with real credentials
# 2. Generate a strong SECRET_KEY with: openssl rand -hex 32
# 3. Update OAuth redirect URIs in Google Cloud Console & GitHub Settings
# 4. Use HTTPS in production for security
# 5. Keep DATABASE_URL and all secrets secure
